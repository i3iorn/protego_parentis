<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sync only. Every payload is encrypted before it leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Contextual rules only. Android treats a network name as a location signal,
      so reading the connected Wi-Fi needs the same permission as a position.
      Nothing here is read unless a rule actually needs it, and no coordinate ever
      leaves the device — see ContextProvider.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The enforcement service also takes a fix while answering a locate (LOC-2). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
      Only for answering a locate a parent asked for, and for noticing arrivals at
      saved places. Needs a Play declaration and a video at submission time.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Scanning a family code, and nothing else. Requested when that screen opens
      rather than at install, so a family who never uses a code is never asked.
      No frame is stored: they are decoded in memory and dropped.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Both are allowed under Play's parental-control exception but need a
      declaration form at submission time. See spec section 7.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      OTA updates only. The managed phone never needs this — it installs
      unattended as device owner (see ApkInstaller) — but both roles share one
      manifest, and a parent's own, unmanaged phone still has to ask before
      the system installer will show its confirmation screen at all.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".DementorApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DementorWatch">

        <!--
          The device owner receiver. Android hands provisioning results here, and
          every DevicePolicyManager call is made against this component.
        -->
        <receiver
            android:name=".dpc.DementorDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Tells the setup wizard we want a fully managed device, not a work profile. -->
        <activity
            android:name=".setup.GetProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The one moment we have the teen's attention on a fresh device: pairing,
          permissions, and the monitoring disclosure they must acknowledge.
        -->
        <activity
            android:name=".setup.ComplianceActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.HomeActivity"
            android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Asked once, on first launch, and reachable afterwards only behind the
          PIN. HomeActivity stays the launcher and routes here.
        -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.RoleSetupActivity"
            android:exported="false" />

        <!-- Parent mode. None of these exist on the child's phone. -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.ParentHomeActivity"
            android:exported="false" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.ParentDeviceActivity"
            android:exported="false"
            android:parentActivityName=".ui.ParentHomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
                    android:name=".ui.ParentInboxActivity"
            android:exported="false"
            android:parentActivityName=".ui.ParentHomeActivity" />

        <!--
          Reached through Rules now, not the dashboard directly (#78 part 3) —
          Rules is what makes the daily limit and bonus time reachable at all
          on a parent's phone, local or remote.
        -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.ParentBonusActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.RulesetPickerActivity"
            android:exported="false"
            android:parentActivityName=".ui.ParentHomeActivity" />

        <!--
          Settings, for both kinds of phone (#78 part 1) — reachable top-level
          from either role's own home, same as Family devices and Chat below.
          It is never a notification destination itself, so unlike those two
          this one has no dynamic stack to get right; the declared parent is
          only the fallback for a launch with no real back stack behind it.
        -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.ParentHomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.RoleSwitchActivity"
            android:exported="false"
            android:parentActivityName=".ui.SettingsActivity" />

        <!--
          The shared history. Deliberately not gated: a record only the parent
          can read is not a shared record. Reachable top-level from both home
          screens (#78 part 2), but unlike Family devices and Chat its own two
          notifications (a lock, a locate) only ever fire on the child's own
          phone — never the parent's — so HomeActivity is always the right
          root here, and this one needed no dynamic stack in part 4.
        -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.AuditActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.CategoriesActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.BlockedAppsActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.GoalActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <!--
          Behind Settings now, not Rules — moved there with the rest of "this
          phone's role" when Settings became one screen (#78 part 1). This entry
          was left pointing at the old parent until now.
        -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.DeviceControlActivity"
            android:exported="false"
            android:parentActivityName=".ui.SettingsActivity" />

        <!--
          The black-hole tunnel for apps with no internet (WF-4).

          BIND_VPN_SERVICE is enforced by the system, so only Android can start it.
          The device owner names this package as the always-on VPN, which is also
          what grants the consent — nothing is ever tapped on the child's phone.
        -->
        <service
            android:name=".enforcement.BlockingVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.SosActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.WebActivityActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.AutoApprovalActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.AutoApprovalEditActivity"
            android:exported="false"
            android:parentActivityName=".ui.AutoApprovalActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.WebFilterActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.AppControlActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.ContextRulesActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.ContextRuleEditActivity"
            android:exported="false"
            android:parentActivityName=".ui.ContextRulesActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.NightscoutActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.PlaceAlertsActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.PlacesActivity"
            android:exported="false"
            android:parentActivityName=".ui.ContextRulesActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.PrivacyActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.DiagnosticsActivity"
            android:exported="false"
            android:parentActivityName=".ui.PrivacyActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.RulesTutorialActivity"
            android:exported="false"
            android:parentActivityName=".ui.ContextRulesActivity" />

        <!--
          Reachable top-level from either role's own home now (#78 part 2),
          not through Rules. There is no one manifest entry correct for both —
          RequestNotifier builds this screen's notification back stack by hand
          for that reason. This declaration is only the fallback for a launch
          with no real back stack behind it already (a deep link, a shortcut).
        -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.FamilyDevicesActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <!--
          Pairing over the local network. Both are ordinary screens: they hold no
          state, start nothing that outlives them, and exist only while somebody
          is looking at one of them.
        -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.LanOfferActivity"
            android:exported="false"
            android:parentActivityName=".ui.JoinFamilyActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.LanFindActivity"
            android:exported="false"
            android:parentActivityName=".ui.JoinFamilyActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.PermissionsActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.ScanQrActivity"
            android:exported="false"
            android:parentActivityName=".ui.JoinFamilyActivity" />

        <!--
          Reachable top-level from either role's own home (#78 part 2), same as
          Family devices above — RequestNotifier builds its notification back
          stack by hand for the same reason; this is only the fallback.
        -->
        <activity
            android:name=".ui.ChatActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Behind Settings now, not Rules — see DeviceControlActivity above. -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.FeatureSettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.SettingsActivity" />

        <!-- Only reached when a parent's family has more than one managed phone. -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.FeatureSettingsPickerActivity"
            android:exported="false"
            android:parentActivityName=".ui.SettingsActivity" />

        <!-- Behind Settings now, not More — More was deleted in #78 part 2. -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.NotificationSettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.SyncBackendActivity"
            android:exported="false"
            android:parentActivityName=".ui.JoinFamilyActivity" />

        <!--
          Reached from Family devices' "Sync & relay" row, not Rules — that row
          moved when Settings absorbed Rules' old Family group (#78 parts 1-3).
        -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.JoinFamilyActivity"
            android:exported="false"
            android:parentActivityName=".ui.FamilyDevicesActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.CelebrationActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.RequestsActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.RequestInboxActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.WeekActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <!-- Day detail screen opened from the weekly view -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.DayDetailActivity"
            android:exported="true" />

        <!--
          excludeFromRecents so the PIN screen cannot be skipped by resuming the
          rules editor from the recents list.
        -->
        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.PinActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.AppPickerActivity"
            android:exported="false" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.AppLimitsActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.BonusTimeActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <activity android:windowSoftInputMode="adjustResize"
            android:name=".ui.CategoryEditActivity"
            android:exported="false"
            android:parentActivityName=".ui.HomeActivity" />

        <receiver
            android:name=".enforcement.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Reads notifications only to answer one question: is an app running a
          navigation route right now? The listener keeps the posting package, the
          category and the ongoing flag, and nothing else — no title, no text, no
          sender. It exists so bedtime does not close the map mid-route.

          Exported, because BIND_NOTIFICATION_LISTENER_SERVICE is enforced by the
          system and only Android may bind it.
        -->
        <service
            android:name=".context.NavigationWatcher"
            android:exported="true"
            android:label="@string/nav_watcher_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".enforcement.EnforcementService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforces the family's screen-time rules and keeps the parent's dashboard current." />
        </service>

        <service
            android:name=".sync.RealtimeSyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the family's message stream open so requests and commands arrive in real time." />
        </service>

        <!-- Hears back from the silent PackageInstaller session ApkInstaller commits. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!--
          Exposes a downloaded update APK to the system installer for the
          parent's-phone, tap-to-confirm path — see
          ApkInstaller.installWithConfirmation. Not used at all on the
          managed phone, which installs through PackageInstaller directly
          and never needs a content:// URI for the file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
