<?xml version="1.0" encoding="utf-8"?>
<!--
  A crescent moon inside four clock marks: evening, and time.

  Not a shield and not a padlock. Those are the house style of surveillance
  software, and this app's whole argument is that it is something a child can
  reasonably agree to — the icon should not open by contradicting that.

  Everything sits inside a circle of radius 33 about the centre, which is the
  adaptive-icon safe zone. A launcher may crop this to a circle, a squircle or a
  rounded square, and only that inner circle is guaranteed to survive.

  One flat colour throughout, so this drawable also serves as the monochrome
  layer: Android takes the alpha and applies the wallpaper tint itself.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The moon: a disc with a second, larger disc subtracted from its upper right.
      evenOdd is what makes the overlap a hole rather than a union, so the two
      subpaths must stay in this order.
    -->
    <path
        android:fillColor="#FFEDF2FA"
        android:fillType="evenOdd"
        android:pathData="M34,55 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 M39,45 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0" />

    <!-- Four marks where the hours would be. Twelve would be truer to a clock
         face and illegible at the size a launcher actually draws this. -->
    <path
        android:fillColor="#FFEDF2FA"
        android:pathData="M52.25,23 h3.5 v7 h-3.5 z M52.25,78 h3.5 v7 h-3.5 z M23,52.25 h7 v3.5 h-7 z M78,52.25 h7 v3.5 h-7 z" />
</vector>
