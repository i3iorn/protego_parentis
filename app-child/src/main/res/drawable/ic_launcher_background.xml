<?xml version="1.0" encoding="utf-8"?>
<!--
  Dusk, as a flat gradient.

  The brand colours, running dark at the top-left to lighter at the bottom-right,
  so the icon reads as a sky rather than a swatch. No pattern and no texture: an
  adaptive background is cropped to an unknown shape by the launcher, and anything
  with structure in it gets cut somewhere unfortunate.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF25395F" android:offset="0.0" />
                <item android:color="#FF3A5A93" android:offset="0.55" />
                <item android:color="#FF4C74B4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
