<?xml version="1.0" encoding="utf-8"?>
<!--
  The teen's dashboard.

  Ordered by what someone opening the app actually wants to know: how much time is
  left, then why, then where to go. The summary is a card so it reads as one
  answer rather than three stacked sentences, and navigation is a list of labelled
  rows rather than a column of identical buttons.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingRight="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_4xl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_lg"
            android:text="@string/home_title"
            android:textAppearance="@style/TextAppearance.Dementor.Title" />

        <!-- Shown only until usage access is granted. -->
        <LinearLayout
            android:id="@+id/permission_card"
            style="@style/Widget.Dementor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_permission_title"
                android:textAppearance="@style/TextAppearance.Dementor.Subtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/home_permission_body"
                android:textAppearance="@style/TextAppearance.Dementor.Body" />

            <Button
                android:id="@+id/permission_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/home_permission_button" />
        </LinearLayout>

        <!--
          Shown only while the family is unfinished: a phone waiting to be
          approved, or one that has approved nobody yet. Above the summary,
          because until it is dealt with nothing else on this screen can arrive.
        -->
        <LinearLayout
            android:id="@+id/family_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- The one answer the screen exists to give. -->
        <LinearLayout
            android:id="@+id/summary_card"
            style="@style/Widget.Dementor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Dementor.Display" />

            <ProgressBar
                android:id="@+id/budget_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/budget_bar_height"
                android:layout_marginTop="@dimen/space_md"
                android:max="100" />

            <TextView
                android:id="@+id/subline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Dementor.Body" />

            <TextView
                android:id="@+id/mode_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textAppearance="@style/TextAppearance.Dementor.Caption" />
        </LinearLayout>

        <!--
          The emergency button (LOC-3).

          Above the navigation and outside any list, because it has to be found by
          someone who is not reading. It works with every app suspended and the
          day's allowance spent: a safety feature behind a limit is not one.
        -->
        <Button
            android:id="@+id/sos_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/sos_button" />

        <!-- Navigation. Built in code so each row carries a description. -->
        <LinearLayout
            android:id="@+id/navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/home_rules_header"
            android:textAppearance="@style/TextAppearance.Dementor.Section" />

        <!-- Limit, bedtime, whatever context rule is running, and the category
             allowances. All four are "what applies to me right now", and splitting
             them across two headings made one idea look like two. -->
        <LinearLayout
            android:id="@+id/rules_list"
            style="@style/Widget.Dementor.Group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/home_would_block_header"
            android:textAppearance="@style/TextAppearance.Dementor.Section" />

        <LinearLayout
            android:id="@+id/blocked_list"
            style="@style/Widget.Dementor.Group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/home_apps_header"
            android:textAppearance="@style/TextAppearance.Dementor.Section" />

        <LinearLayout
            android:id="@+id/app_list"
            style="@style/Widget.Dementor.Group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm" />
    </LinearLayout>
</ScrollView>
