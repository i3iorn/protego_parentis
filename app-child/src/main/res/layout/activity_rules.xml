<?xml version="1.0" encoding="utf-8"?>
<!--
  The parent's hub.

  Previously one scroll holding every setting in the app, which had grown past the
  point where anything could be found. Each group now has its own screen and this
  lists them, so the hierarchy is visible instead of implied by scroll position.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rules_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingRight="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_4xl"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_lg"
            android:text="@string/rules_title"
            android:textAppearance="@style/TextAppearance.Dementor.Title" />

        <LinearLayout
            android:id="@+id/status_card"
            style="@style/Widget.Dementor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/device_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Dementor.Body" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:text="@string/rules_group_limits"
            android:textAppearance="@style/TextAppearance.Dementor.Section" />

        <LinearLayout
            android:id="@+id/group_limits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:text="@string/rules_group_day"
            android:textAppearance="@style/TextAppearance.Dementor.Section" />

        <LinearLayout
            android:id="@+id/group_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:text="@string/rules_group_family"
            android:textAppearance="@style/TextAppearance.Dementor.Section" />

        <LinearLayout
            android:id="@+id/group_family"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:text="@string/rules_group_device"
            android:textAppearance="@style/TextAppearance.Dementor.Section" />

        <LinearLayout
            android:id="@+id/group_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
