    <!-- Privacy and diagnostics. -->
    <string name="privacy_title">What leaves this phone</string>
    <string name="privacy_measured_header">Measured here</string>
    <string name="privacy_measured_body">Which apps you open and for how long, your total screen time each day, and which rules applied. This is worked out on the phone and kept on the phone.</string>
    <string name="privacy_never_header">Never collected</string>
    <string name="privacy_never_body">Your messages, your photos, what you type, what is on your screen, your location, your browsing, and the contents of any app. None of it is read, stored or sent.</string>
    <string name="privacy_sent_header">Sent off the phone</string>
    <string name="privacy_sent_body">Only when you ask for more time, or when a request is answered. What is sent: how many minutes were asked for, what for, the reason you wrote, and whether the answer was yes or no. Nothing else — no app list, no screen time, no location. Every message is encrypted on this phone first, so the server cannot read any of it.</string>
    <string name="privacy_sent_off">Nothing. Sending to parent phones is turned off, so this phone talks to no server at all.</string>
    <string name="privacy_sent_server">Server: %1$s</string>
    <string name="privacy_log_header">The app\'s own log</string>
    <string name="privacy_log_body">A short record of what the app did — that it checked your time, that it started, that something failed. It holds no app names, no reasons you wrote and no times you were using anything. You can read all of it.</string>
    <string name="privacy_view_log">Read the log</string>
    <string name="home_open_privacy">What leaves this phone</string>

