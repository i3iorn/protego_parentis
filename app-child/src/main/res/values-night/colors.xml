<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark equivalents. Not simple inversions: the state colours are lightened so they
  keep their contrast against a dark surface, which a straight inversion loses.

  The window is darker than the groups here too, so the same "raised" reading
  survives the theme change.
-->
<resources>

    <color name="brand">#A8BEEC</color>
    <color name="brand_dark">#8AA2D4</color>

    <color name="window_background">#0D1017</color>
    <color name="card">#1A1F2B</color>
    <color name="card_stroke">#2E3648</color>

    <color name="text_primary">#EEF1F7</color>
    <color name="text_secondary">#98A3B6</color>

    <color name="state_ok">#63C79C</color>
    <color name="state_warning">#E5A950</color>
    <color name="state_critical">#EE8398</color>

    <color name="week_bar_fill">#7CA6EE</color>
    <color name="week_bar_track">#2E3648</color>

</resources>
