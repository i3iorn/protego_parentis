<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages this app ships.

  This file is the single source of truth: the picker reads it back at runtime
  through `LocaleConfig`, so adding a language means adding a line here and a
  matching `values-xx/strings.xml`. Nothing in Kotlin needs to change.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="sv" />
</locale-config>
